<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RKL third-party notices</title>
  <style>
    :root { color-scheme: light dark; --fg: #1d1d1f; --bg: #fff; --muted: #6e6e73; --card: #f5f5f7; }
    @media (prefers-color-scheme: dark) { :root { --fg: #f5f5f7; --bg: #111; --muted: #a1a1a6; --card: #1c1c1e; } }
    body { font: 15px/1.5 system-ui, sans-serif; color: var(--fg); background: var(--bg); max-width: 960px; margin: 0 auto; padding: 24px 16px; }
    h1 { font-size: 1.6rem; } h2 { font-size: 1.15rem; margin-top: 2rem; }
    .muted { color: var(--muted); }
    ul.overview { columns: 2; padding-left: 1.2rem; }
    .license { background: var(--card); border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
    .license ul { padding-left: 1.2rem; font-size: 0.9rem; }
    pre { white-space: pre-wrap; word-break: break-word; font-size: 0.8rem; }
  </style>
</head>
<body>
  <h1>Third-party notices</h1>
  <p class="muted">RKL is licensed under MIT OR Apache-2.0. It includes the following Rust crates, grouped by licence.
    Generated by <code>cargo about</code>.</p>
  <h2>Overview</h2>
  <ul class="overview">
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  <h2>Licence texts</h2>
  {{#each licenses}}
  <section class="license">
    <h3 id="{{id}}">{{name}}</h3>
    <p class="muted">Used by:</p>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
