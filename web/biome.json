{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!dist", "!coverage", "!src/bindings.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              "react",
              ":BLANK_LINE:",
              [
                ":NODE:",
                ":PACKAGE:",
                "!@assets/**",
                "!@components/**",
                "!@hooks/**",
                "!@i18n/**",
                "!@lib/**",
                "!@stores/**",
                "!@test/**",
                "!@views/**",
                "!@src/**"
              ],
              ":BLANK_LINE:",
              [
                "@assets/**",
                "@components/**",
                "@hooks/**",
                "@i18n/**",
                "@lib/**",
                "@stores/**",
                "@test/**",
                "@views/**",
                "@src/**"
              ],
              ":BLANK_LINE:",
              ":PATH:"
            ],
            "identifierOrder": "lexicographic"
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@wailsio/runtime": {
                "importNames": ["Call"],
                "message": "Use the generated commands from src/bindings.ts instead of Call()."
              }
            },
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "Import through the folder aliases (@components/…, @lib/…, @src/…) instead of a relative path."
              }
            ]
          }
        }
      },
      "nursery": {
        "useReactCompiler": "error",
        "useReactNamingConvention": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/i18n/locales/**", "!src/i18n/locales/en/**"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
