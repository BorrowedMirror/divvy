{
  "$comment": "GENERATED by `go generate ./...` (cmd/commitconfig) from .commit-config.toml; do not edit.",
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "body-leading-blank": [
      2,
      "always"
    ],
    "footer-leading-blank": [
      2,
      "always"
    ],
    "header-max-length": [
      2,
      "always",
      72
    ],
    "scope-case": [
      2,
      "always",
      "lower-case"
    ],
    "scope-enum": [
      2,
      "always",
      [
        "cargo",
        "codecov",
        "commitlint",
        "config",
        "core",
        "data",
        "deps",
        "desktop",
        "e2e",
        "fake-game",
        "github",
        "platform",
        "pnpm",
        "renovate",
        "trade",
        "web"
      ]
    ],
    "subject-case": [
      2,
      "always",
      "lower-case"
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ],
    "type-enum": [
      2,
      "always",
      [
        "build",
        "ci",
        "docs",
        "feat",
        "fix",
        "i18n",
        "l10n",
        "perf",
        "refactor",
        "release",
        "revert",
        "test"
      ]
    ]
  }
}
