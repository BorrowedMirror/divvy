{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kalandra",
  "version": "0.1.0-rc.1",
  "identifier": "au.nerv.kalandra",
  "build": {
    "beforeDevCommand": "pnpm --filter kalandra-web dev",
    "beforeBuildCommand": "pnpm --filter kalandra-web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "kalandra overlay",
        "url": "index.html#/overlay",
        "width": 420,
        "height": 560,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "kalandra settings",
        "url": "index.html#/settings",
        "width": 900,
        "height": 680,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://web.poecdn.com data:; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Path of Exile 2 price-check overlay",
    "licenseFile": "../../../LICENSE-MIT",
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0",
          "libxtst6",
          "libxkbcommon0"
        ]
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libXtst.so.6()(64bit)",
          "libxkbcommon.so.0()(64bit)"
        ]
      }
    },
    "longDescription": "Hover an item in Path of Exile 2 and press Ctrl+D to see its price from the official trade API in an overlay beside the cursor. Reads only the item text the game copies to the clipboard.",
    "publisher": "kalandra contributors",
    "copyright": "Copyright (c) 2026 kalandra contributors. MIT OR Apache-2.0."
  }
}
