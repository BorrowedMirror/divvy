{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["gomod", "cargo", "npm", "github-actions"],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageLowerCase": "auto",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
  "packageRules": [
    {
      "description": "Actions are pinned to commit digests (with a version comment); batch their bumps.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Lint/test tooling minor+patch in one PR.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web dev tooling"
    },
    {
      "description": "Wails v3 moves fast; its Go module and the wails3 tool (tools/go.mod) move together.",
      "matchPackageNames": ["github.com/wailsapp/wails/v3", "github.com/wailsapp/wails/v3/**"],
      "groupName": "wails"
    },
    {
      "description": "The pinned Go tools (tools/go.mod) minor+patch in one PR.",
      "matchManagers": ["gomod"],
      "matchFileNames": ["tools/go.mod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go tools"
    }
  ]
}
