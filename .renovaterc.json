{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    ":semanticCommitScope(deps)",
    ":prHourlyLimitNone",
    ":separatePatchReleases",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
  "enabledManagers": ["cargo", "custom.regex", "github-actions", "gomod", "npm", "rust-toolchain"],
  "commitMessageLowerCase": "auto",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
  "customManagers": [
    {
      "description": "Python tools CI runs with pipx run <name>==<version>",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["pipx run (?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Node.js major in workflows (node-version: 26.x)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["node-version: (?<currentValue>\\d+)\\.x"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "description": "Images CI runs with docker run, pinned as <image>:<version>@sha256:<digest>",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>(?:[a-z0-9.-]+/)+[a-z0-9._-]+):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
